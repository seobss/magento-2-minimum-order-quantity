<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../Config/etc/system_file.xsd">
    <system>
        <tab id="bss" translate="label" sortOrder="300">
            <label><![CDATA[Bss Commerce]]></label>
        </tab>
        <section id="Bss_Commerce" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>LimitCartQty</label>
            <tab>bss</tab>
            <resource>Bss_Limitcartqty::config</resource>
            <group id="item_options" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Stock Options</label>
                <field id="Bss_min_total_qty" translate="label" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Minimum Quantity Allowed for Entire Cart</label>
                    <frontend_model>Bss\Limitcartqty\Block\Adminhtml\Form\Field\Mintotalqty</frontend_model>
                    <backend_model>Bss\Limitcartqty\Model\System\Config\Backend\ConfigModel</backend_model>
                </field>
                <field id="Bss_min_total_qty_message" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Message Alert For Minimum Value</label>
                    <validate>validate-length maximum-length-100</validate>
                    <comment>Insert "-conf-" for config value and "-cart-" for cart value. Ex: "The fewest you can purchase is -conf-, you already have -cart-!". Limit 100 characters.</comment>
                </field>
                <field id="Bss_max_total_qty" translate="label" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Maximum Quantity Allowed for Entire Cart</label>
                    <frontend_model>Bss\Limitcartqty\Block\Adminhtml\Form\Field\Maxtotalqty</frontend_model>
                    <backend_model>Bss\Limitcartqty\Model\System\Config\Backend\ConfigModel</backend_model>
                </field>
                <field id="Bss_max_total_qty_message" translate="label" type="text" sortOrder="35" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Message Alert For Maximum Value</label>
                    <validate>validate-length maximum-length-100</validate>
                    <comment>Insert "-conf-" for config value and "-cart-" for cart value. Ex: "The most you can purchase is -conf-, you already have -cart-!". Limit 100 characters.</comment>
                </field>
            </group>
            <group id="Limitcartqty" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="Enable" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                        <label>Bss_Limitcartqty</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group> 
        </section>            
    </system>
</config>
